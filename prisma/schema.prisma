// ============================================================
// NexoDesk · Modelo de datos del Helpdesk (el ciclo del ticket)
// Nota: SQLite no soporta enums de Prisma -> usamos String + constantes
// en src/lib/constants.ts (SOURCE, STATUS, PRIORITY, CATEGORY).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Agente de soporte (especialidades separadas por coma: finanzas,tecnico,cuentas,general)
model Agent {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  specialties String   // "finanzas,general"
  color       String   @default("#10b981") // color de avatar
  isActive    Boolean  @default(true)
  tickets     Ticket[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// La unidad central del helpdesk
model Ticket {
  id             String    @id @default(cuid())
  ref            String    @unique // TCK-1001 (visible al cliente)
  subject        String
  description    String
  status         String    @default("ABIERTO") // ABIERTO | EN_ESPERA | RESUELTO | CERRADO
  priority       String    @default("MEDIA") // BAJA | MEDIA | ALTA | CRITICA
  source         String    @default("EMAIL") // EMAIL | FORMULARIO_WEB | WHATSAPP | CHAT_EN_VIVO
  category       String    @default("GENERAL") // FINANZAS | TECNICO | CUENTAS | GENERAL
  customerName   String
  customerEmail  String
  customerPhone  String?   // teléfono del cliente (canal WhatsApp; formato E.164)
  assigneeId     String?
  assignee       Agent?    @relation(fields: [assigneeId], references: [id])
  routingReason  String?   // explicación del motor de enrutamiento
  firstResponseAt DateTime? // SLA: primera respuesta del agente
  resolvedAt     DateTime?
  closedAt       DateTime?
  csatScore      Int?      // 1 = Triste, 2 = Neutral, 3 = Feliz
  csatComment    String?
  csatSentAt     DateTime? // cuándo se envió el correo de encuesta
  visitorId      String?   // identificador del chat en vivo (Socket.io)
  messages       Message[]
  notes          InternalNote[]
  emails         EmailLog[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([assigneeId])
  @@index([source])
}

// Hilo de conversación cliente <-> agente
model Message {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType String   // CUSTOMER | AGENT | SYSTEM
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

// Notas internas: ocultas para el cliente, visibles para el equipo
model InternalNote {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

// Base de conocimiento / FAQ (deflexión de tickets + copiloto IA)
model KBArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  tags      String   @default("") // "pagos,facturación"
  keywords  String   @default("") // sinónimos extra para la búsqueda semántica
  views     Int      @default(0)  // veces que resolvió una duda (deflexión)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bandeja de salida simulada (adaptador de email: SendGrid / AWS SES)
model EmailLog {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  body      String
  kind      String // TICKET_CREATED | AGENT_REPLY | CSAT_REQUEST | STATUS_CHANGE
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  provider  String   @default("sendgrid-simulado")
  createdAt DateTime @default(now())

  @@index([ticketId])
}

# ============================================================
# NexoDesk · variables de entorno
# Copia este archivo a .env y ajusta lo que necesites.
# Todo lo marcado como OPCIONAL funciona sin definir (modo demo).
# ============================================================

# --- Base de datos (OBLIGATORIO) ---
# Desarrollo: SQLite (no requiere nada más)
DATABASE_URL="file:./prisma/dev.db"
# Producción en VPS con MySQL (ver docs/DESPLIEGUE.md):
# DATABASE_URL="mysql://nexodesk:password@localhost:3306/helpdesk"
# Producción (PostgreSQL 16 + pgvector, ver docs/MIGRACION-POSTGRES.md):
# DATABASE_URL="postgresql://usuario:password@host:5432/nexodesk"

# --- WebSocket del navegador (OPCIONAL · solo en VPS de producción) ---
# En el sandbox no se definen: usa /?XTransformPort=3003 con path '/'.
# En la VPS (Caddy estándar) el build debe llevar:
#   NEXT_PUBLIC_SOCKET_URL="/"
#   NEXT_PUBLIC_SOCKET_PATH="/socket.io"
# (deploy/deploy.sh ya los fija; deben coincidir con SOCKET_PATH del
#  mini-servicio realtime. Cambiarlos implica re-compilar.)

# --- Tiempo real (OPCIONAL) ---
# Mini-servicio Socket.io; el backend lo usa para emitir eventos.
# REALTIME_URL="http://localhost:3010"

# --- Email saliente (OPCIONAL: SendGrid real vs simulado) ---
# Sin SENDGRID_API_KEY los correos quedan registrados en la
# bandeja de salida simulada (modelo EmailLog), sin envío real.
# SENDGRID_API_KEY="SG.xxxxxxxx"
# EMAIL_FROM="soporte@tuempresa.com"
# EMAIL_FROM_NAME="NexoDesk Soporte"

# --- WhatsApp (OPCIONAL: Twilio WhatsApp Business) ---
# Sin credenciales el canal queda en modo demo (los mensajes se
# registran en el ticket, sin envío real).
# TWILIO_ACCOUNT_SID="ACxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxx"
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Webhooks entrantes (OPCIONAL, recomendado en producción) ---
# Secreto compartido para /api/webhooks/email-inbound?secret=…
# INBOUND_WEBHOOK_SECRET="cambia-esto"

# --- Búsqueda semántica KB (OPCIONAL: pgvector) ---
# En producción con PostgreSQL: KB_SEARCH=pgvector activa la
# búsqueda por embeddings (requiere kb:backfill). Sin esto se usa
# el motor léxico-semántico local incluido.
# KB_SEARCH="pgvector"
# EMBEDDINGS_API_KEY="xxxxxxxx"
# EMBEDDINGS_API_URL="https://api.openai.com/v1/embeddings"
# EMBEDDINGS_MODEL="text-embedding-3-small"
# EMBEDDINGS_DIMS="1536"

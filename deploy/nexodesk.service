# ============================================================
# NexoDesk · servicio systemd de la app (Next.js standalone)
# ------------------------------------------------------------
# Instalación:
#   sudo cp deploy/nexodesk.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nexodesk
# ------------------------------------------------------------
# Nota e2-micro (1 GB compartido con MySQL y más webs):
#   · MemoryMax contiene al proceso y OOMScoreAdjust hace que
#     ceda ANTES que MySQL si el sistema se queda sin memoria.
# ============================================================
[Unit]
Description=NexoDesk Helpdesk (Next.js standalone)
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=nexodesk
Group=nexodesk
WorkingDirectory=/opt/nexodesk/current
EnvironmentFile=/opt/nexodesk/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=always
RestartSec=5

# Presupuesto de memoria y prioridad ante OOM
MemoryMax=400M
OOMScoreAdjust=300

# Higiene básica
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
